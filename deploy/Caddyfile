# EasyTier Web Console behind Caddy: the console's static build and the easytier-web API on one
# origin, so the session cookie works without any cross-site setup (README 「部署」).
#
# SITE_ADDRESS: a domain (automatic HTTPS), `localhost` (local CA) or `:80` (plain HTTP).
{$SITE_ADDRESS:localhost} {
	encode gzip

	# The REST API (and OIDC login) of the original easytier-web.
	handle /api/* {
		reverse_proxy easytier-web:11211
	}

	# Optional runtime config (deploy/config.js.example). The build ships an empty one; if it is
	# removed, answer an empty script so the page still loads (no config = same origin).
	handle /config.js {
		root * /srv
		header Cache-Control "no-cache"
		@missing not file
		header @missing Content-Type "text/javascript; charset=utf-8"
		respond @missing 200
		file_server
	}

	handle {
		root * /srv
		# Hashed assets never change; the page itself is revalidated on every load.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
		file_server
	}
}
